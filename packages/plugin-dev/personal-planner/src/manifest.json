{
  "id": "personal-planner",
  "name": "Mi planificación",
  "version": "0.5.0",
  "description": "Hoy, objetivos y disponibilidad semanal con datos reales de tus tareas.",
  "manifestVersion": 1,
  "minSupVersion": "19.2.0",
  "iFrame": true,
  "sidePanel": false,
  "hooks": [
    "persistedDataChanged",
    "anyTaskUpdate",
    "currentTaskChange",
    "projectListUpdate",
    "languageChange"
  ],
  "permissions": [
    "getTasks",
    "getArchivedTasks",
    "getAllProjects",
    "getAllTags",
    "getAppState",
    "loadSyncedData",
    "selectTask",
    "compareAndSwapSyncedData",
    "plannerOperation",
    "getCurrentLanguage",
    "translate"
  ],
  "i18n": {
    "languages": ["en", "es"]
  }
}
